# Server Environment Variables
NODE_ENV=development

# Supabase Transaction Pooler URL (Port 6543) for app queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (Port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NevaCloud Object Storage Credentials & S3 Config
NEVACLOUD_ACCESS_KEY_ID="your-nevacloud-access-key-id"
NEVACLOUD_SECRET_ACCESS_KEY="your-nevacloud-secret-access-key"
NEVACLOUD_STORAGE_REGION="id-jkt-1"
NEVACLOUD_STORAGE_ENDPOINT="https://s3.nevacloud.io"
NEVACLOUD_STORAGE_BUCKET="voteplay-assets"
NEVACLOUD_STORAGE_CDN_URL="https://cdn.nevacloud.io/voteplay-assets"

# Security & Cron Secrets
SECURITY_HASH_PEPPER="super-secret-pepper-key-for-vote-hashing"
CRON_SECRET="secret-bearer-token-for-cron-worker"
API_SECRET_KEY="01234567890123456789012345678901"
REDIS_URL="redis://localhost:6379"

# Client Environment Variables
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
